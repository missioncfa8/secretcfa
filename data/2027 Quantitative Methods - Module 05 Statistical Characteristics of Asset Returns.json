              "position": 1
            },
            {
              "id": "2d04e0df-e6dd-4c3b-ac61-a9ba30c9c1a3",
              "itemBody": "<p>B. normal.</p>",
              "position": 2
            },
            {
              "id": "ff567198-46d0-4fef-bf9f-327b60a91cff",
              "itemBody": "<p>C. positively skewed</p>",
              "position": 3
