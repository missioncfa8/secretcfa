    {
      "id": "2027-Quan-5-12",
      "entry": {
        "title": "2027 Quantitative Methods Mod5-Q12",
        "itemBody": "<p>A return distribution with negative skew and a mean of zero most likely has:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "fc7de1f8-01b8-4919-9d39-4a7509178a2b",
