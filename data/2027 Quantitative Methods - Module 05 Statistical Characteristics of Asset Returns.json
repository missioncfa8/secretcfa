    {
      "id": "2027-Quan-5-11",
      "entry": {
        "title": "2027 Quantitative Methods Mod5-Q11",
        "itemBody": "<p>For a given expected return and standard deviation, investors are most likely to be attracted to return distributions that are:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "fc16ab54-980c-4037-869f-1ce9f603d7ec",
