              "id": "9c1a9a7f-95c7-49f6-9a8c-17983bd2a1fe",
              "itemBody": "<p>B. stays the same.</p>",
              "position": 2
            },
            {
              "id": "002f4c62-0539-4a5c-b54a-1b89ef9e3513",
              "itemBody": "<p>C. increases.</p>",
