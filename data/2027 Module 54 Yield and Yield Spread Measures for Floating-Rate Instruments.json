      "entry": {
        "title": "CFA2438-R-s03-Q10",
        "feedback": {
          "neutral": "\n            <p style=\"margin-top: 0.75rem; margin-bottom: 0.75rem;\">B is correct. The required margin is the yield spread over or under a reference rate, reflecting the credit risk of an issuer. Changes in the required margin typically come from a change in the issuer’s credit risk.</p>\n            <p style=\"margin-top: 0.75rem; margin-bottom: 0.75rem;\">A and C are incorrect. Both risks, as “top-down” or macroeconomic risks, would be reflected in changes in the MRR, not in a spread such as the required margin.</p>\n         "
        },
        "itemBody": "<p style=\"margin-top: 0.75rem; margin-bottom: 0.75rem;\">Changes in the required margin for a floater usually come from: </p>",
        "properties": {
