    {
      "id": "55042",
      "entry": {
        "title": "ITEM_CFA-MC-2021.05-FI-Kassem-11",
        "feedback": {},
        "itemBody": "<p>Money market yields are:</p>",
        "properties": {
          "shuffleRules": {
            "choices": {
              "toLock": [],
              "shuffled": false
            }
          },
          "varyPointsByAnswer": false
        },
        "scoringData": {
          "value": "ec52e7b5-7634-4b68-96cb-21becca23d2e"
        },
        "answerFeedback": {
          "59533b4b-b660-416b-84fd-9fa3ff803366": "<p>Incorrect because money market instruments having different times-to-maturity have different periodicities for the annual rate.</p>",
          "de32f99d-dc20-4001-9284-59299b3580fd": "<p>Incorrect because bond yields-to-maturity are annualized and compounded. Yield measures in the money market are annualized but not compounded.</p>",
          "ec52e7b5-7634-4b68-96cb-21becca23d2e": "<p>Correct because the rate of return on a money market instrument is stated on a simple interest basis.</p>"
        },
        "calculatorType": "none",
        "interactionData": {
          "choices": [
            {
              "id": "de32f99d-dc20-4001-9284-59299b3580fd",
              "itemBody": "<p>A. annualized and compounded.</p>",
              "position": 1
            },
            {
              "id": "59533b4b-b660-416b-84fd-9fa3ff803366",
              "itemBody": "<p>B. stated for a common periodicity.&nbsp;</p>",
              "position": 2
            },
            {
              "id": "ec52e7b5-7634-4b68-96cb-21becca23d2e",
              "itemBody": "<p>C. stated on a simple interest basis.&nbsp;</p>",
              "position": 3
            }
          ]
        },
        "scoringAlgorithm": "Equivalence",
        "interactionTypeSlug": "choice"
      },
      "status": "mutable",
      "archived": false,
      "position": 1,
      "entryType": "Item",
      "properties": {},
