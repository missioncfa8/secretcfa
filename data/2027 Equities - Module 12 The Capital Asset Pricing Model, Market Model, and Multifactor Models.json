    {
      "id": "2027-Equi-12-2",
      "entry": {
        "title": "2027 Equities Mod12-Q2",
        "itemBody": "<p>Assuming a risk-free rate of 4%, compared to a stock with a beta (βa) of 0.70, the cost of equity for a stock with a beta (βb) of 1.40 will be:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "7e8833a3-4c0e-4d20-9c71-d12df8555d40",
              "itemBody": "<p>A. twice as high.</p>",
              "position": 1
            },
            {
              "id": "ae111446-8b90-41bd-a540-b89df06c1f09",
              "itemBody": "<p>B. less than twice as high.</p>",
              "position": 2
            },
            {
              "id": "203bfc5d-50ea-43a7-a326-8cfc3b843a1e",
              "itemBody": "<p>C. more than twice as high.</p>",
