    {
      "id": "2027-Quan-3-5",
      "entry": {
        "title": "2027 Quantitative Methods Mod3-Q5",
        "itemBody": "<p>Stock A is included in both an equal-weighted index and a price-weighted index, with the same proportional representation in each. A two-for-one stock split for Stock A is announced and will take effect immediately before the reweighting date of both indexes. Assuming no other stocks in the indexes undergo splits and there are no significant price fluctuations or capital distributions for these stocks, the price change due to the stock split for Stock A will impact:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "2bb63648-0d28-4429-b32c-6d66f681b036",
              "itemBody": "<p>A. both indexes the same.</p>",
              "position": 1
            },
            {
              "id": "ba18ae8a-9d27-4138-8d42-77c676d653d3",
              "itemBody": "<p>B. the price-weighted index more than the equal-weighted index.</p>",
              "position": 2
            },
            {
              "id": "e30515c8-68a1-4c3a-bdea-3d72cfe4c094",
              "itemBody": "<p>C. the equal-weighted index more than the price-weighted index</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
          "value": "2bb63648-0d28-4429-b32c-6d66f681b036"
