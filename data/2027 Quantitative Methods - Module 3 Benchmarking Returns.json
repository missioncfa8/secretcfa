    {
      "id": "2027-Quan-3-2",
      "entry": {
        "title": "2027 Quantitative Methods Mod3-Q2",
        "itemBody": "<p>The fund attracts another net USD400 million at the start of Year 2 and earns a return of 8% in Year 2. The fund’s money-weighted rate of return is:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "e365343e-fb1d-4324-86b7-5fc5cd1878ac",
              "itemBody": "<p>A. less than its time-weighted rate of return.</p>",
              "position": 1
            },
            {
              "id": "e0ae3152-2358-4739-b8c7-29fcdbb9456b",
              "itemBody": "<p>B. the same as its time-weighted rate of return.</p>",
              "position": 2
            },
            {
              "id": "6a3a48c3-34ad-469e-bd7c-326fc92199aa",
              "itemBody": "<p>C. greater than its time-weighted rate of return.</p>",
              "position": 3
            }
