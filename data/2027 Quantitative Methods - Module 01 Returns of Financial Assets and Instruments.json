  "items": [
    {
      "id": "2027-Quan-1-1",
      "entry": {
        "title": "2027 Quantitative Methods Mod1-Q1",
        "itemBody": "<p>An investor purchased 100 shares of a stock for NOK34.50 per share at the beginning of the quarter. At the end of the quarter, the investor sells the shares for NOK30.50 per share after receiving a total dividend payment of NOK51.55 at the end of the quarter. The holding period return is closest to:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "80ba338f-a7c0-4a0e-bdc2-1ad6b04b2542",
              "itemBody": "<p>A. −13.08%.</p>",
              "position": 1
            },
            {
              "id": "219474e9-0a38-4243-a288-a05cec5dbf52",
              "itemBody": "<p>B. −11.59%.</p>",
              "position": 2
            },
            {
              "id": "dd27025e-50b0-4d16-a163-599b67ad74fb",
              "itemBody": "<p>C. −10.10%. An analyst obtains the following annual rates of return for a mutual fund: Year Return (%) Year 1 14.0 Year 2 −10.0 Year 3 −2.0</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
          "value": "80ba338f-a7c0-4a0e-bdc2-1ad6b04b2542"
        },
        "properties": {
