              "shuffled": false
            }
          }
        },
        "scoringAlgorithm": "Equivalence",
        "interactionTypeSlug": "choice"
      }
    },
    {
      "id": "2027-Quan-1-16",
      "entry": {
        "title": "2027 Quantitative Methods Mod1-Q16",
        "itemBody": "<p>The annualized return for an investor who has achieved a return of 5% over a six-week period is closest to:</p>",
