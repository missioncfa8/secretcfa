    {
      "id": "2027-Quan-1-4",
      "entry": {
        "title": "2027 Quantitative Methods Mod1-Q4",
        "itemBody": "<p>An analyst observes the following annual rates of return generated by an investment manager: Year Investment Manager Return (%) Year 1 19.5 Year Investment Manager Return (%) Year 2 −1.9 Year 3 19.7 Year 4 35.0 Year 5 5.7 The geometric mean return for the investment manager is closest to:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "3f9155c8-4df0-40d2-b310-debc204f3b84",
              "itemBody": "<p>A. 14.9%.</p>",
              "position": 1
            },
            {
              "id": "22229546-ddab-433e-8203-acea20da7da3",
              "itemBody": "<p>B. 15.6%.</p>",
              "position": 2
            },
            {
              "id": "4aaca7d5-950a-4dea-baff-04a93e0d9bd7",
              "itemBody": "<p>C. 20.05%.</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
