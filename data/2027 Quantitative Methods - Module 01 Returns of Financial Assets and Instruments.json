              "itemBody": "<p>A. 0.5%.</p>",
              "position": 1
            },
            {
              "id": "8efdd233-22c0-472f-a9c4-660c5bdde780",
              "itemBody": "<p>B. 1.6%.</p>",
              "position": 2
            },
            {
              "id": "7cee1237-7938-464e-97fe-1161af3a017f",
              "itemBody": "<p>C. 2.7%.</p>",
