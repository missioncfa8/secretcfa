    {
      "id": "2027-Quan-1-17",
      "entry": {
        "title": "2027 Quantitative Methods Mod1-Q17",
        "itemBody": "<p>Over the past four years, a portfolio experienced returns of −8%, 4%, 17%, and −12%. The geometric mean return of the portfolio over the four-year period is closest to:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "5b66af40-2bce-43a7-9042-6b05e63b327d",
              "itemBody": "<p>A. −0.37%.</p>",
              "position": 1
            },
            {
              "id": "508e3748-2357-4234-b099-c84bba44ff5d",
              "itemBody": "<p>B. 0.25%.</p>",
              "position": 2
            },
            {
