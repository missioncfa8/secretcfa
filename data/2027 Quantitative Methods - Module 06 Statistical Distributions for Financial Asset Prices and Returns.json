    {
      "id": "2027-Quan-6-9",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q9",
        "itemBody": "<p>An analyst wants to estimate the potential stock market reaction to the next monetary policy meeting that may change the prevailing policy rate. The analyst estimates the following probabilities for market reactions in the event of no change in the monetary policy rate, a 25 bp reduction, or a 50 bp reduction. In the event of a 50 bp reduction, the return variance is closest to:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "af92b9cf-2028-45c3-b707-639dc91ddefc",
              "itemBody": "<p>A. 0.003.</p>",
              "position": 1
            },
            {
              "id": "77448704-e961-4507-b810-00354278d3f1",
              "itemBody": "<p>B. 5.449.</p>",
              "position": 2
            },
            {
              "id": "1cb78a7e-d445-448b-b066-2ed31c9b17d8",
              "itemBody": "<p>C. 7.422.</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
          "value": "af92b9cf-2028-45c3-b707-639dc91ddefc"
        },
        "properties": {
          "shuffleRules": {
            "choices": {
              "toLock": [],
