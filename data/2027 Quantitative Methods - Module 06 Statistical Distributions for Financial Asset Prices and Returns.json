        "scoringAlgorithm": "Equivalence",
        "interactionTypeSlug": "choice"
      }
    },
    {
      "id": "2027-Quan-6-5",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q5",
        "itemBody": "<p>A bond has a hazard rate (default probability) of 0.03 per year. The probability that it will default within the next five years is closest to:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "df411fe7-3258-4c67-a436-c000537c319b",
              "itemBody": "<p>A. 13.9%.</p>",
              "position": 1
            },
            {
              "id": "0605f336-c632-4031-9248-b1d8aef6f8c6",
              "itemBody": "<p>B. 15.0%.</p>",
              "position": 2
            },
            {
              "id": "b1dc884a-cf65-49f5-8424-a274530d636b",
              "itemBody": "<p>C. 16.2%.</p>",
