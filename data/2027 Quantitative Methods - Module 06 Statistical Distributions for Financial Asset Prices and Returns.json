    {
      "id": "2027-Quan-6-4",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q4",
        "itemBody": "<p>A typical characteristic of a Poisson distribution is that:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "66decd3a-0db7-4f6f-9fc7-7629ef508da9",
              "itemBody": "<p>A. variance is unrelated to the mean.</p>",
              "position": 1
            },
            {
              "id": "f7dd2720-73d7-4d6b-a1ca-0c080d1dc95b",
              "itemBody": "<p>B. skewness decreases as λ increases.</p>",
              "position": 2
            },
            {
              "id": "20370a10-e4a6-47f8-9ce8-50eabbef4d39",
              "itemBody": "<p>C. skewness and kurtosis are independent of λ</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
          "value": "66decd3a-0db7-4f6f-9fc7-7629ef508da9"
        },
        "properties": {
          "shuffleRules": {
            "choices": {
