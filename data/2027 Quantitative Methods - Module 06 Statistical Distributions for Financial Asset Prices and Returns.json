      "id": "2027-Quan-6-1",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q1",
        "itemBody": "<p>The variance of a sample indicates:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "7f99b82c-7920-4ed5-9297-bc49fa808d67",
              "itemBody": "<p>A. the spread of a random variable around its mean.</p>",
              "position": 1
            },
            {
              "id": "3fd06243-c15b-4ec8-9b0c-a4d79daa6c48",
              "itemBody": "<p>B. the direction of the linear relationship between two variables.</p>",
              "position": 2
            },
            {
              "id": "336edac1-3988-4a90-b846-92aa79f2aab8",
              "itemBody": "<p>C. the probability-weighted average outcome for a random variable over an infinite number of trials</p>",
              "position": 3
