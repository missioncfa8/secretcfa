    {
      "id": "2027-Quan-6-10",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q10",
        "itemBody": "<p>In contrast to normal distributions, lognormal distributions:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "2f3d7b07-896e-4ff3-ba79-60ad1d08dd3e",
              "itemBody": "<p>A. are skewed to the left.</p>",
              "position": 1
            },
            {
              "id": "83317966-5d95-4086-aeb4-70228ba5d626",
              "itemBody": "<p>B. have random variables that cannot be negative.</p>",
              "position": 2
            },
            {
              "id": "d4f3d5b6-f55f-4102-a57a-ce1d630e0f2c",
              "itemBody": "<p>C. are more suitable for describing asset returns than asset prices.</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
          "value": "2f3d7b07-896e-4ff3-ba79-60ad1d08dd3e"
        },
        "properties": {
          "shuffleRules": {
            "choices": {
