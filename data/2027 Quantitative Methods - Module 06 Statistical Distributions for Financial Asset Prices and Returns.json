    {
      "id": "2027-Quan-6-6",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q6",
        "itemBody": "<p>The log-normal distribution is:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "2be84e82-2e52-4ac3-af23-5d4f8fcf5693",
              "itemBody": "<p>A. S-shaped.</p>",
              "position": 1
            },
            {
              "id": "103fe0f3-f49d-4905-8d0f-e552b7ca4315",
              "itemBody": "<p>B. symmetrical.</p>",
              "position": 2
            },
            {
              "id": "de245529-1f06-4761-852f-eb55bde20205",
              "itemBody": "<p>C. skewed to the right.</p>",
              "position": 3
            }
          ]
        },
