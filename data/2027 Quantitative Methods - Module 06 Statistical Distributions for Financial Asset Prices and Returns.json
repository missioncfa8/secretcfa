    {
      "id": "2027-Quan-6-11",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q11",
        "itemBody": "<p>The conditional expected value of a random variable is best described as the:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "b3acf3df-d0a6-433a-9a74-c46c324c50fa",
              "itemBody": "<p>A. expected value of a random variable given an event or scenario.</p>",
              "position": 1
            },
            {
              "id": "6db0cd3a-4e1a-443a-aa43-81414b0af41e",
              "itemBody": "<p>B. probability-weighted average of the possible outcomes of the random variable.</p>",
              "position": 2
            },
            {
              "id": "ce45aae2-6c43-46b1-9cd2-53a63fb077bf",
              "itemBody": "<p>C. weighted average of the probabilities of an event given all possible scenarios.</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
          "value": "b3acf3df-d0a6-433a-9a74-c46c324c50fa"
        },
