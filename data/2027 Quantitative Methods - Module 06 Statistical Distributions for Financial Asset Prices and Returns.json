    {
      "id": "2027-Quan-6-7",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q7",
        "itemBody": "<p>The probability distribution for a company’s sales is: Probability Sales (USD, millions) 0.05 70 0.70 40 0.25 25 The standard deviation of sales is closest to which of the following?</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "5bd014df-43d2-4e85-8b7e-66f0d326b960",
              "itemBody": "<p>A. USD9.61 million</p>",
              "position": 1
            },
            {
              "id": "3b60f1e3-464b-4088-9c03-370b7a1bd79c",
              "itemBody": "<p>B. USD9.81 million</p>",
              "position": 2
            },
            {
              "id": "19423275-293c-4ab5-bf5f-1a2397fcff42",
              "itemBody": "<p>C. USD96.18 million</p>",
