    {
      "id": "2027-Quan-6-13",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q13",
        "itemBody": "<p>When working backward from the nodes on a binomial tree diagram, the analyst is most likely attempting to calculate:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "27b4e913-0e57-461a-a1ee-b8ee7cb0414d",
              "itemBody": "<p>A. an expected value as of today.</p>",
              "position": 1
            },
            {
              "id": "941c41d3-836c-4e3e-9477-933e11d7a8b2",
              "itemBody": "<p>B. the number of potential outcomes.</p>",
              "position": 2
            },
            {
              "id": "245e4ccf-07c0-4691-9197-0589c4a9944b",
              "itemBody": "<p>C. the probability of a given scenario</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
