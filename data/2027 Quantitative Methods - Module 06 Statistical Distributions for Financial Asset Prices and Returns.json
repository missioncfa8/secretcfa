    {
      "id": "2027-Quan-6-12",
      "entry": {
        "title": "2027 Quantitative Methods Mod6-Q12",
        "itemBody": "<p>A tree diagram is most likely used when dealing with investment problems that involve outcomes that are:</p>",
        "feedback": {
          "neutral": ""
        },
        "interactionData": {
          "choices": [
            {
              "id": "e2c8726e-8e70-4bb4-82f8-8a79ca367c1e",
              "itemBody": "<p>A. mutually exclusive.</p>",
              "position": 1
            },
            {
              "id": "4481bb91-fa8a-44d7-931d-58bf79cfa0df",
              "itemBody": "<p>B. independent at each node.</p>",
              "position": 2
            },
            {
              "id": "d225b07e-fafe-4db9-a976-a2271a902c35",
              "itemBody": "<p>C. unconditional at each node.</p>",
              "position": 3
            }
          ]
        },
        "scoringData": {
          "value": "e2c8726e-8e70-4bb4-82f8-8a79ca367c1e"
        },
        "properties": {
          "shuffleRules": {
